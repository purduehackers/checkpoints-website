TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Purdue Hackers ID (https://id.purduehackers.com). Create an application there with scopes openid, profile and roles,
# and the redirect URL <site origin>/api/auth/callback (e.g. http://localhost:4321/api/auth/callback for `bun dev`).
ID_CLIENT_ID=
# Only for a confidential application; leave empty for a public one (PKCE is used either way).
ID_CLIENT_SECRET=
# Signs the session cookie. Any long random string: `openssl rand -base64 32`. Changing it signs everyone out.
SESSION_SECRET=
# Optional: a local ID (`deno task dev` in ../id), e.g. http://localhost:5173/api/auth
# ID_ISSUER=https://id.purduehackers.com/api/auth
# Optional: pin the public origin used for the redirect URL. Defaults to the host the request came in on.
# APP_ORIGIN=https://checkpoints.purduehackers.com

# Optional: address shown on the projector as "Join at ...". Defaults to the host the projector was opened on.
# PUBLIC_ vars are inlined at build time (on Vercel, set it before the deploy builds, then redeploy).
# PUBLIC_JOIN_HOST=checkpoints.purduehackers.com
